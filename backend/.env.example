# Copy to backend/.env and fill in. NEVER commit .env or put these values in the React app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase Dashboard -> Project Settings -> API -> service_role key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of website addresses allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173
# Long random string; needed to confirm/cancel bookings via the admin endpoint
ADMIN_API_KEY=
# Used to decide what "today" is when checking pickup dates (e.g. America/Los_Angeles, Asia/Karachi)
BUSINESS_TIMEZONE=UTC
MAX_RENTAL_DAYS=90
