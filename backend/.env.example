# Copy to backend/.env and fill in. NEVER commit .env or put these values in the React app.
SUPABASE_URL=https://ovuoeapkuuvrizhtlgcv.supabase.co
# Supabase Dashboard -> car-a-rental -> Project Settings -> API Keys -> secret / service_role key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to sign login tokens (keeps people logged in across restarts)
JWT_SECRET=
# Comma-separated list of website addresses allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173
# Used to decide what "today" is when checking pickup dates
BUSINESS_TIMEZONE=America/Los_Angeles
MAX_RENTAL_DAYS=90
